{
	"version": "0.0.0",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev:up": "docker compose up -d --remove-orphans",
		"dev:down": "docker compose down",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "(svelte-kit sync || true) && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && prettier --check .",
		"lint:fix": "eslint --fix . && prettier --write .",
		"format": "prettier --write .",
		"test:unit": "vitest --run",
		"test:watch": "vitest",
		"test": "vitest --run",
		"db:push": "node --env-file=.env scripts/check-db.ts && drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file=.env scripts/check-db.ts && drizzle-kit migrate",
		"db:studio": "node --env-file=.env scripts/check-db.ts && drizzle-kit studio",
		"auth:schema": "SCHEMA=src/lib/server/db/auth.schema.ts; svelte-kit sync && auth generate --config src/lib/server/auth.ts --output $SCHEMA --yes && eslint --fix $SCHEMA && prettier --write $SCHEMA",
		"auth:secret": "node scripts/auth-secret.ts"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@eslint/js": "10.0.1",
		"@neondatabase/serverless": "1.2.0",
		"@sveltejs/adapter-vercel": "7.0.2",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "22.20.5",
		"@types/pg": "8.23.1",
		"@types/ws": "8.18.2",
		"@vercel/functions": "3.11.0",
		"auth": "1.7.18",
		"better-auth": "1.7.18",
		"drizzle-kit": "0.31.11",
		"drizzle-orm": "0.45.4",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"eslint-plugin-svelte": "3.24.0",
		"globals": "17.14.0",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"nodemailer": "10.4.0",
		"pg": "8.23.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"resend": "6.37.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.6",
		"vitest": "4.1.12",
		"ws": "8.22.1"
	},
	"overrides": {
		"rolldown": "1.2.16",
		"@rolldown/pluginutils": "1.0.1",
		"jose@^6": "6.2.15",
		"ansi-regex@^6": "6.5.0",
		"commander@^15": "15.0.0",
		"postcss-selector-parser": "7.1.7",
		"@eslint-community/regexpp": "4.12.2",
		"@clack/core": "1.5.1",
		"@clack/prompts": "1.8.1"
	}
}
