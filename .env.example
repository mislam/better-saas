# Public app URL — must match the URL in the browser (Better Auth cookies / CSRF).
APP_URL=http://localhost:5173

# Database (PostgreSQL connection URL)
# Local: Docker Postgres + Neon proxy (compose.yaml); hostname must be db.localtest.me
# Production: replace with connection string from the Neon dashboard
DATABASE_URL=postgresql://postgres:postgres@db.localtest.me:5432/main

# Better Auth secret for encryption and hashing.
# Run: `bun auth:secret --write` to generate a real secret.
BETTER_AUTH_SECRET=
