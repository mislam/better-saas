# Public app URL — must match the URL in the browser (Better Auth cookies / CSRF).
APP_URL=http://localhost:5173

# Database (PostgreSQL connection URL)
# Local default: Postgres 16+ already running on localhost:5432.
# User postgres, password postgres, database main. Create that database before `pnpm db:push`.
# Optional Compose (`pnpm dev:up`) starts a server with these values.
# Production: a hosted Postgres URL. Hosts ending in .neon.tech use the Neon serverless driver.
# Optional same-driver path: start Compose, then use
# postgresql://postgres:postgres@db.localtest.me:5432/main
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/main

# Better Auth secret — at least 32 characters (generate: `pnpm auth:secret --write`).
BETTER_AUTH_SECRET=

# Outbound email — from address for sending emails
EMAIL_FROM=Better SaaS <no-reply@localhost>

# Resend API key. When set, mail is sent through Resend.
# Leave this and SMTP_HOST empty to print verification and reset links in the dev server log.
RESEND_API_KEY=

# SMTP. Leave empty when mail is not configured.
# Optional Mailpit, if you start it: SMTP_HOST=localhost and SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=
