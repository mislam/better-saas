# Public app URL — must match the URL in the browser (Better Auth cookies / CSRF).
APP_URL=http://localhost:5173

# Database (PostgreSQL connection URL)
# Local: Docker Postgres + Neon proxy (compose.yaml); hostname must be db.localtest.me
# Production: replace with connection string from the Neon dashboard
DATABASE_URL=postgresql://postgres:postgres@db.localtest.me:5432/main

# Better Auth secret — at least 32 characters (generate: `bun auth:secret --write`).
BETTER_AUTH_SECRET=

# Outbound email — from address for sending emails
EMAIL_FROM=Better SaaS <no-reply@localhost>

# Resend API key for sending emails on production; leave empty on local dev
RESEND_API_KEY=

# SMTP host and port for sending emails on local dev; DO NOT set on production
SMTP_HOST=localhost
SMTP_PORT=1025
