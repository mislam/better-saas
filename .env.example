# Public origin — must match the URL in the browser (Better Auth cookies / CSRF).
ORIGIN=http://localhost:5173

# Database (PostgreSQL connection URL)
# Local dev: Neon serverless Pool (WebSocket), same driver as production
# See: https://neon.com/guides/local-development-with-neon
DATABASE_URL=postgresql://postgres:postgres@db.localtest.me:5432/main

# Better Auth secret for encryption and hashing.
# Run: `bun auth:secret --write` to generate a real secret.
BETTER_AUTH_SECRET=
